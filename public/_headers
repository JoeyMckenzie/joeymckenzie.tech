# Cloudflare reads this file from the root of the deployed asset directory.
# `public/` is copied verbatim into `out/`, so it lands where it needs to be.
#
# Every matching block applies, not just the most specific one: a path matched
# here and by the catch-all below gets the union of both, and a header named in
# two matching blocks arrives with both values joined by a comma. So a block
# should set only what is specific to it and let `/*` supply the rest --
# repeating a common header duplicates its value rather than overriding it.
# Verified against `npx wrangler pages dev out`, which runs the Pages runtime.

# Everything under `_next/static` carries a content hash in its filename, so a
# changed file is always a changed URL. That makes it safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Post images are stable but not content-hashed -- a re-upload reuses the same
# path -- so this is a month rather than a year.
/images/*
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff

# The raw markdown behind the "View as Markdown" button. Two things make this
# block necessary. A route handler's own `Content-Type` is discarded by
# `output: "export"` -- only the body reaches disk -- so the type here is
# whatever Cloudflare infers from the extension, and `text/markdown` is a type
# browsers download rather than render. `text/plain` is what makes the button
# open the source in a tab, and it costs `curl` nothing.
#
# `noindex` because each of these is a byte-for-byte duplicate of a post that is
# already indexed. It is set here rather than as a `Disallow` in robots.txt on
# purpose: a disallowed URL is never fetched, so the crawler never sees the
# noindex, and Google can still index a blocked URL it finds linked. The header
# is the instruction that actually removes them.
/blog/*/index.md
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# HTML has to stay revalidated or a deploy would not reach anyone still holding
# a cached page. `must-revalidate` keeps the browser honest about the 0 age.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

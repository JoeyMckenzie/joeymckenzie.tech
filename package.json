{
    "name": "website-astro",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=24.19.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "deploy": "astro build && wrangler deploy",
        "cf:preview": "astro build && wrangler dev",
        "astro": "astro",
        "fmt": "prettier --write .",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "fmt:check": "prettier --check .",
        "types:check": "astro check"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.5",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.3",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.1",
        "sharp": "^0.35.0",
        "tailwindcss": "^4.3.3"
    },
    "allowScripts": {
        "esbuild": true
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.1",
        "eslint-plugin-astro": "^3.1.0",
        "globals": "^17.11.0",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "wrangler": "^4.125.0"
    }

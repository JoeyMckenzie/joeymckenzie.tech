---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Only tags that actually have posts, alphabetically -- same set the old
// Tag::whereHas('posts')->orderBy('name') query produced.
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

// Post count per tag, shown on the chips. Reading the row top to bottom is the
// polyglot arc: .NET -> Angular -> Rust -> Laravel.
const tagCounts = Object.fromEntries(
    tags.map((tag) => [
        tag,
        posts.filter((post) => post.data.tags.includes(tag)).length,
    ])
);
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead
            title="Writing"
            description="Writing about Laravel, PHP, and whatever has my attention this month."
        />
    </head>
    <body>
        <Header />
        <main>
            <header>
                <h1 class="m-0">Writing</h1>
                <div class="sweep"></div>
                <p class="text-subtle mt-4 mb-0 max-w-[34rem]">
                    Laravel, Rust, .NET, and whatever tooling rabbit hole has me
                    this month. Mostly code, occasionally opinions.
                </p>
            </header>

            <div class="mt-10">
                <label class="relative block">
                    <svg
                        class="text-subtle pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                    </svg>
                    <input
                        class="border-hairline bg-code-bg text-prose placeholder:text-subtle focus:border-iris w-full rounded-lg border py-2.5 pr-3 pl-10 font-[inherit] text-[0.9rem] transition-[border-color] duration-200 placeholder:opacity-100 focus:shadow-[0_0_0_1px_var(--iris)] focus:outline-none"
                        type="search"
                        id="post-search"
                        placeholder="Search posts…"
                        aria-label="Search posts"
                        autocomplete="off"
                    />
                </label>

                <div class="chips mt-4 flex flex-wrap gap-2" id="tag-chips">
                    <button
                        class="border-hairline text-subtle inline-flex cursor-pointer items-center gap-[0.45rem] rounded-full border bg-transparent py-1 pr-[0.7rem] pl-[0.6rem] font-mono text-xs transition-all duration-200"
                        type="button"
                        data-tag=""
                        aria-pressed="true">all</button
                    >
                    {
                        tags.map((tag) => (
                            <button
                                class="border-hairline text-subtle inline-flex cursor-pointer items-center gap-[0.45rem] rounded-full border bg-transparent py-1 pr-[0.7rem] pl-[0.6rem] font-mono text-xs transition-all duration-200"
                                type="button"
                                data-tag={tag}
                                aria-pressed="false"
                            >
                                {tag}
                                <span class="count text-subtle text-[0.6875rem] opacity-75">
                                    {tagCounts[tag]}
                                </span>
                            </button>
                        ))
                    }
                </div>
            </div>

            <div class="mt-8 grid gap-4" id="results">
                {
                    posts.map((post) => (
                        <div
                            class="result"
                            data-tag={post.data.tags[0] ?? ""}
                            data-title={post.data.title.toLowerCase()}
                            data-description={post.data.description.toLowerCase()}
                        >
                            <PostCard {post} />
                        </div>
                    ))
                }
            </div>

            <div
                class="empty border-hairline mt-8 rounded-xl border border-dashed px-6 py-16 text-center"
                id="empty"
                hidden
            >
                <p class="text-prose-strong m-0 text-xl">No matches</p>
                <p class="text-subtle mt-2 mb-0 text-[0.9rem]" id="empty-note">
                    Nothing fits that filter.
                </p>
                <button
                    class="text-iris mt-4 cursor-pointer border-none bg-transparent font-mono text-xs hover:underline"
                    type="button"
                    id="clear-filters">✕ clear filters</button
                >
            </div>
        </main>
        <Footer
            filetype="directory"
            right={[`${posts.length} posts`, `1:${posts.length}`]}
        />
    </body>
</html>

<script>
    const search = document.getElementById("post-search") as HTMLInputElement;
    const chips = document.getElementById("tag-chips")!;
    const results = Array.from(
        document.querySelectorAll<HTMLElement>("#results .result")
    );
    const empty = document.getElementById("empty")!;
    const emptyNote = document.getElementById("empty-note")!;
    const clear = document.getElementById("clear-filters")!;

    let activeTag = "";
    let query = "";

    function apply() {
        const q = query.trim().toLowerCase();
        let visible = 0;

        for (const el of results) {
            const matchesTag = !activeTag || el.dataset.tag === activeTag;
            const matchesQuery =
                !q ||
                el.dataset.title!.includes(q) ||
                el.dataset.description!.includes(q);
            const show = matchesTag && matchesQuery;
            el.hidden = !show;
            if (show) visible++;
        }

        empty.hidden = visible > 0;
        emptyNote.textContent = activeTag
            ? `Nothing fits that filter in ${activeTag}.`
            : "Nothing fits that filter.";

        for (const chip of chips.querySelectorAll("button")) {
            chip.setAttribute(
                "aria-pressed",
                String((chip.dataset.tag ?? "") === activeTag)
            );
        }

        // Keep ?tag= / ?search= in the URL so filtered views stay linkable,
        // dropping empty params the way the old toParams() helper did.
        const params = new URLSearchParams();
        if (activeTag) params.set("tag", activeTag);
        if (query) params.set("search", query);
        const qs = params.toString();
        history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    }

    // Restore state from the URL so deep links keep working.
    const initial = new URLSearchParams(location.search);
    activeTag = initial.get("tag") ?? "";
    query = initial.get("search") ?? "";
    search.value = query;

    let debounce: ReturnType<typeof setTimeout>;
    search.addEventListener("input", () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => {
            query = search.value;
            apply();
        }, 300);
    });

    chips.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest("button");
        if (!button) return;
        const tag = button.dataset.tag ?? "";
        activeTag = tag && tag !== activeTag ? tag : "";
        apply();
    });

    clear.addEventListener("click", () => {
        activeTag = "";
        query = "";
        search.value = "";
        apply();
    });

    apply();
</script>

<style>
    /* What stays as CSS here, and why: every rule below is either a per-tag
       `color-mix()` tint keyed off the declarative `--tag`, or an attribute
       selector that reads far worse as an arbitrary-value variant. */

    /* The dot is the tag's own colour, so the arc is legible before you read a
       single label. The "all" chip has no data-tag and so gets no dot. */
    .chips button[data-tag]:not([data-tag=""])::before {
        content: "";
        width: 0.45em;
        height: 0.45em;
        border-radius: 50%;
        background: var(--tag);
    }
    .chips button:hover {
        border-color: color-mix(
            in oklab,
            var(--tag, var(--iris)) 50%,
            transparent
        );
        color: var(--prose);
    }
    .chips button[aria-pressed="true"] {
        border-color: var(--tag, var(--iris));
        background: color-mix(
            in oklab,
            var(--tag, var(--iris)) 12%,
            transparent
        );
        color: var(--tag, var(--iris));
    }
    .chips button[aria-pressed="true"] .count {
        color: inherit;
    }

    /* PostCard sets `display: grid`, which outranks the UA `[hidden]` rule, so
       the filter's `el.hidden = true` needs this to actually hide a card. */
    .result[hidden],
    .empty[hidden] {
        display: none;
    }
</style>

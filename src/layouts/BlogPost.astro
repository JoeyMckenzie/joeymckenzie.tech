---
import "../styles/global.css";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { countWords, readingMinutes } from "../lib/reading";

interface Props {
    post: CollectionEntry<"blog">;
    index: number;
    total: number;
}

const { post, index, total } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const words = countWords(post.body);
// Reads like nvim's line:col, and actually means something -- this is post
// `index` of `total` in reverse-chronological order.
const position = `${index}:${total}`;
---

<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body>
        <Header />
        <main>
            <article class="prose">
                <header class="post-head">
                    <h1>{title}</h1>
                    <div class="meta">
                        <FormattedDate date={pubDate} />
                        <span aria-hidden="true">&middot;</span>
                        <span>{readingMinutes(words)} min read</span>
                        {
                            updatedDate && (
                                <span class="updated">
                                    updated <FormattedDate date={updatedDate} />
                                </span>
                            )
                        }
                    </div>
                    {
                        tags && tags.length > 0 && (
                            <p class="tags">
                                {tags.map((tag) => (
                                    <span class="tag" data-tag={tag}>
                                        {tag}
                                    </span>
                                ))}
                            </p>
                        )
                    }
                </header>

                {
                    heroImage && (
                        <figure
                            class="figure-frame"
                            data-label="image"
                            style={`--hero-ar:${heroImage.width / heroImage.height}`}
                        >
                            <Image
                                src={heroImage}
                                width={Math.min(heroImage.width, 1760)}
                                alt=""
                            />
                        </figure>
                    )
                }

                <slot />
            </article>
        </main>
        <Footer
            right={[
                `${words.toLocaleString("en-US")} words`,
                `${readingMinutes(words)} min`,
                position,
            ]}
        />
    </body>
</html>

<style>
    /* The post is the only page whose main is a bare column: code blocks and
       the hero break out of it to --measure-wide. */
    main {
        width: var(--measure);
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 3em 1em;
    }

    .post-head {
        margin-bottom: 2.5rem;
    }

    .post-head h1 {
        margin: 0;
    }

    /* Left-aligned, not centered: a centered meta block fights the buffer
       reading the rest of the page is going for. */
    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.85rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
        color: var(--subtle);
    }

    .updated {
        font-style: italic;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin: 1rem 0 0;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        padding: 0.2em 0.7em 0.2em 0.6em;
        border: 1px solid color-mix(in oklab, var(--tag) 40%, var(--hairline));
        border-radius: 999px;
        background: color-mix(in oklab, var(--tag) 10%, transparent);
        color: var(--tag);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
    }

    .tag::before {
        content: "";
        width: 0.45em;
        height: 0.45em;
        border-radius: 50%;
        background: var(--tag);
    }
</style>

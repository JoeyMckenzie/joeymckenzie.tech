---
import "../styles/global.css";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { countWords, readingMinutes } from "../lib/reading";

interface Props {
    post: CollectionEntry<"blog">;
    index: number;
    total: number;
}

const { post, index, total } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const words = countWords(post.body);
const position = `${index}:${total}`;
---

<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body>
        <Header />
        <main
            class="mx-auto w-[var(--measure)] max-w-[calc(100%-2em)] px-[1em] py-[3em]"
        >
            <article class="prose">
                <header class="mb-10">
                    <h1 class="m-0">{title}</h1>
                    <div
                        class="text-subtle mt-[0.85rem] flex flex-wrap items-center gap-2 font-mono text-xs tracking-[0.03em]"
                    >
                        <FormattedDate date={pubDate} />
                        <span aria-hidden="true">&middot;</span>
                        <span>{readingMinutes(words)} min read</span>
                        {
                            updatedDate && (
                                <span class="italic">
                                    updated <FormattedDate date={updatedDate} />
                                </span>
                            )
                        }
                    </div>
                    {
                        tags && tags.length > 0 && (
                            <p class="mt-4 mb-0 flex flex-wrap gap-[0.5em]">
                                {tags.map((tag) => (
                                    <span
                                        class="tag inline-flex items-center gap-[0.45em] rounded-full py-[0.2em] pr-[0.7em] pl-[0.6em] font-mono text-xs tracking-[0.03em] text-[var(--tag)]"
                                        data-tag={tag}
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </p>
                        )
                    }
                </header>

                {
                    heroImage && (
                        <figure
                            class="figure-frame"
                            data-label="image"
                            style={`--hero-ar:${heroImage.width / heroImage.height}`}
                        >
                            <Image
                                src={heroImage}
                                width={Math.min(heroImage.width, 1760)}
                                alt=""
                            />
                        </figure>
                    )
                }

                <slot />
            </article>
        </main>
        <Footer
            right={[
                `${words.toLocaleString("en-US")} words`,
                `${readingMinutes(words)} min`,
                position,
            ]}
        />
    </body>
</html>

<style>
    .tag {
        border: 1px solid color-mix(in oklab, var(--tag) 40%, var(--hairline));
        background: color-mix(in oklab, var(--tag) 10%, transparent);
    }
</style>

---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

// `kicker` is gone: the bracketed active nav link carries the location cue.
interface Props {
    title: string;
    description: string;
    heading: string;
    intro?: string;
    updated?: string;
    updatedLabel?: string;
}

const { title, description, heading, intro, updated, updatedLabel } =
    Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <Header />
        <main>
            <header>
                <h1 class="m-0">{heading}</h1>
                {
                    updated && (
                        <time
                            class="text-subtle mt-2 block font-mono text-xs tracking-wider"
                            datetime={updated}
                        >
                            {updatedLabel}
                        </time>
                    )
                }
                <div class="sweep"></div>
                {
                    intro && (
                        <p class="text-subtle mt-5 mb-0 max-w-[34rem]">
                            {intro}
                        </p>
                    )
                }
            </header>
            <slot />
        </main>
        <Footer />
    </body>
</html>

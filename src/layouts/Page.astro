---
import BaseHead from "../components/BaseHead.astro"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"

// `kicker` is gone: the winbar derives `~/now.md` and friends from the URL.
interface Props {
    title: string
    description: string
    heading: string
    intro?: string
    updated?: string
    updatedLabel?: string
}

const { title, description, heading, intro, updated, updatedLabel } =
    Astro.props
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <Header />
        <main>
            <header class="page-header">
                <h1>{heading}</h1>
                {
                    updated && (
                        <time class="updated" datetime={updated}>
                            {updatedLabel}
                        </time>
                    )
                }
                <div class="sweep"></div>
                {intro && <p class="intro">{intro}</p>}
            </header>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .page-header h1 {
        margin: 0;
        font-size: 2.125rem;
    }
    .updated {
        display: block;
        margin-top: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--subtle);
    }
    .intro {
        max-width: 34rem;
        margin: 1.25rem 0 0;
        color: var(--subtle);
    }
    @media (max-width: 720px) {
        .page-header h1 {
            font-size: 1.75rem;
        }
    }
</style>

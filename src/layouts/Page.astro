---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

// `kicker` is gone: the bracketed active nav link carries the location cue.
interface Props {
    title: string;
    description: string;
    heading: string;
    intro?: string;
    updated?: string;
    updatedLabel?: string;
}

const { title, description, heading, intro, updated, updatedLabel } =
    Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <Header />
        <main>
            <header class="page-header">
                <h1>{heading}</h1>
                {
                    updated && (
                        <time class="updated" datetime={updated}>
                            {updatedLabel}
                        </time>
                    )
                }
                <div class="sweep"></div>
                {intro && <p class="intro">{intro}</p>}
            </header>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .page-header h1 {
        margin: 0;
    }
    .updated {
        display: block;
        margin-top: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--subtle);
    }
    .intro {
        max-width: 34rem;
        margin: 1.25rem 0 0;
        color: var(--subtle);
    }
</style>

---
import SocialLinks from "./SocialLinks.astro";

const today = new Date();
---

<footer class="border-hairline bg-canvas-deep border-t">
    <div
        class="mx-auto flex w-[var(--measure-wide)] max-w-[calc(100%-2em)] flex-wrap items-center justify-between gap-4 px-[1em] pt-[2em] pb-[3em]"
    >
        <p class="text-subtle m-0 font-mono text-xs tracking-[0.03em]">
            &copy; {today.getFullYear()} Joey McKenzie
            <span class="px-[0.35em] opacity-50" aria-hidden="true">·</span>
            <a
                href="/colophon"
                class="text-subtle hover:text-ember no-underline">colophon</a
            >
            <span class="px-[0.35em] opacity-50" aria-hidden="true">·</span>
            <a href="/rss.xml" class="text-subtle hover:text-ember no-underline"
                >rss</a
            >
        </p>
        <SocialLinks />
    </div>
</footer>

---
// Terminal-ish affordance: shows the *current* state like a statusline segment
// rather than the action, so it reads as an indicator you can poke. The
// accessible name still describes the action, for anyone not looking at it.
---

<button
    id="theme-toggle"
    type="button"
    class="text-subtle hover:text-ember focus-visible:outline-iris cursor-pointer appearance-none border-none bg-transparent px-[0.4em] py-[0.25em] font-mono text-xs leading-none tracking-wider focus-visible:rounded-[2px] focus-visible:outline-1 focus-visible:outline-offset-2"
    aria-label="Switch to light theme"
    aria-live="polite"
>
    <span aria-hidden="true">[</span><span data-theme-label>dark</span><span
        aria-hidden="true">]</span
    >
</button>

<script is:inline>
    (function () {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const label = btn.querySelector("[data-theme-label]");

        function render(theme) {
            label.textContent = theme;
            btn.setAttribute(
                "aria-label",
                "Switch to " + (theme === "dark" ? "light" : "dark") + " theme"
            );
        }

        render(document.documentElement.dataset.theme || "dark");

        btn.addEventListener("click", function () {
            const next =
                document.documentElement.dataset.theme === "dark"
                    ? "light"
                    : "dark";
            document.documentElement.dataset.theme = next;
            try {
                localStorage.setItem("theme", next);
            } catch {
                /* storage blocked: the toggle still works for this page view */
            }
            render(next);
        });
    })();
</script>

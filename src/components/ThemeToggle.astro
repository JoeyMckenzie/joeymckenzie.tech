---
// Terminal-ish affordance: shows the *current* state like a statusline segment
// rather than the action, so it reads as an indicator you can poke. The
// accessible name still describes the action, for anyone not looking at it.
---

<button
    id="theme-toggle"
    type="button"
    aria-label="Switch to light theme"
    aria-live="polite"
>
    <span aria-hidden="true">[</span><span data-theme-label>dark</span><span
        aria-hidden="true">]</span
    >
</button>

<script is:inline>
    ;(function () {
        const btn = document.getElementById("theme-toggle")
        if (!btn) return
        const label = btn.querySelector("[data-theme-label]")

        function render(theme) {
            label.textContent = theme
            btn.setAttribute(
                "aria-label",
                "Switch to " + (theme === "dark" ? "light" : "dark") + " theme"
            )
        }

        render(document.documentElement.dataset.theme || "dark")

        btn.addEventListener("click", function () {
            const next =
                document.documentElement.dataset.theme === "dark"
                    ? "light"
                    : "dark"
            document.documentElement.dataset.theme = next
            try {
                localStorage.setItem("theme", next)
            } catch {
                /* storage blocked: the toggle still works for this page view */
            }
            render(next)
        })
    })()
</script>

<style>
    button {
        appearance: none;
        background: none;
        border: none;
        padding: 0.25em 0.4em;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--subtle);
        line-height: 1;
    }

    button:hover {
        color: var(--ember);
    }

    button:focus-visible {
        outline: 1px solid var(--iris);
        outline-offset: 2px;
        border-radius: 2px;
    }
</style>

---
import { getCollection } from "astro:content";
import { countWords } from "../lib/reading";

// neovim's statusline. The one place the wink is allowed to be explicit, and
// every figure in it is real -- nothing here is decorative filler.
interface Props {
    filetype?: string;
    right?: string[];
}

const { filetype = "markdown", right } = Astro.props;

// Site-wide totals are the default so the prose pages need no plumbing at all;
// post pages and /blog pass their own.
let segments = right;
if (!segments) {
    const posts = await getCollection("blog");
    const words = posts.reduce(
        (total, post) => total + countWords(post.body),
        0
    );
    segments = [
        `${posts.length} posts`,
        `${words.toLocaleString("en-US")} words`,
    ];
}
---

<div class="border-hairline bg-canvas-deep mt-16 border-t">
    <div
        class="text-subtle mx-auto flex w-[var(--measure-wide)] max-w-[calc(100%-2em)] items-center justify-between gap-4 px-[1em] py-[0.5em] font-mono text-[0.7rem] tracking-[0.03em]"
    >
        <span class="flex items-center gap-5 max-md:gap-[0.85rem]">
            <!-- The only saturated fill in the chrome, so it is what the eye
            lands on -- normal mode is blue in tokyonight.
            6.79:1 dark, 4.62:1 light. -->
            <span
                class="bg-iris text-canvas my-[-0.25em] rounded-[2px] px-[0.6em] py-[0.25em] font-medium tracking-[0.08em]"
                >N</span
            >
            <span class="inline-flex items-center gap-[0.4em]">
                <svg
                    viewBox="0 0 16 16"
                    width="11"
                    height="11"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="4" cy="3.5" r="1.8"></circle>
                    <circle cx="4" cy="12.5" r="1.8"></circle>
                    <circle cx="12" cy="3.5" r="1.8"></circle>
                    <path d="M4 5.3v5.4M12 5.3v1.2a3 3 0 0 1-3 3H4"></path>
                </svg>
                main
            </span>
            <span class="max-md:hidden">{filetype}</span>
        </span>
        <span class="flex items-center gap-5 max-md:gap-[0.85rem]">
            {
                /* Below 720px only the rightmost figure survives. Driven off
                   the index rather than a `:not(:last-child)` selector, which
                   says the same thing without one. */
                segments.map((segment, i) => (
                    <span
                        class:list={[
                            i < segments.length - 1 && "max-md:hidden",
                        ]}
                    >
                        {segment}
                    </span>
                ))
            }
        </span>
    </div>
</div>

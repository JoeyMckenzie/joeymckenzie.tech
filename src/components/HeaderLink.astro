---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^/]+/g);
const isActive = href === pathname || href === "/" + (subpath?.[0] || "");
---

<a
    href={href}
    class:list={[className, { active: isActive }]}
    aria-current={isActive ? "page" : undefined}
    {...props}
>
    <slot />
</a>

<style>
    a {
        display: inline-block;
        padding: 1.15em 0.5em;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        /* 4.61:1 dark, 5.11:1 light on --canvas. */
        color: var(--subtle);
        text-decoration: none;
    }

    /* Brackets on the active route, the same affordance as the [dark] toggle.
       They are always in the DOM and only faded in, so switching pages never
       shifts the tabs sideways. */
    a::before,
    a::after {
        color: var(--iris);
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    a::before {
        content: "[";
    }

    a::after {
        content: "]";
    }

    a:hover {
        color: var(--prose);
    }

    a:hover::before,
    a:hover::after {
        opacity: 0.45;
    }

    a.active {
        color: var(--prose-strong);
    }

    a.active::before,
    a.active::after {
        opacity: 1;
    }

    @media (max-width: 720px) {
        /* The tabs get their own row here, so the tall desktop padding is just
           dead height in a header that now floats over the page. Vertical
           padding stays >=0.5em to keep the tap target reasonable. */
        a {
            padding: 0.55em 0.25em;
            letter-spacing: 0.01em;
        }
    }

    a:focus-visible {
        outline: 1px solid var(--iris);
        outline-offset: -2px;
        border-radius: 2px;
    }
</style>

---
// neovim's winbar: the breadcrumb telling you which buffer you're looking at.
// The path is derived from the URL rather than threaded through as a prop --
// that is less code than the `kicker="~/now"` props it replaces, and it cannot
// drift out of sync with the routes.
interface Props {
    tag?: string
    path?: string
}

const { tag, path } = Astro.props

const segments = Astro.url.pathname.split("/").filter(Boolean)

// `/` -> ~/ , `/blog` -> ~/blog/ (a listing, so it keeps the trailing slash),
// everything else is a document and gets a .md suffix.
const derived =
    segments.length === 0
        ? "~/"
        : segments.length === 1 && segments[0] === "blog"
          ? "~/blog/"
          : `~/${segments.join("/")}.md`
---

<div class="winbar">
    <div class="inner">
        <span class="path">{path ?? derived}</span>
        {
            tag && (
                <span class="tag" data-tag={tag}>
                    {tag}
                </span>
            )
        }
    </div>
</div>

<style>
    .winbar {
        background: var(--canvas-deep);
        border-bottom: 1px solid var(--hairline);
    }

    .inner {
        width: var(--measure-wide);
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 0.5em 1em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
    }

    /* 11.14:1 dark, 11.37:1 light against --canvas-deep. */
    .path {
        color: var(--prose);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tag {
        color: var(--tag);
        white-space: nowrap;
    }
</style>

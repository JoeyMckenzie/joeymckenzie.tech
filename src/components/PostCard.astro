---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { countWords, readingMinutes } from "../lib/reading";
import FormattedDate from "./FormattedDate.astro";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const minutes = readingMinutes(countWords(post.body));
const tag = post.data.tags[0];
---

<a
    class="card group border-hairline hover:bg-panel grid grid-cols-[auto_1fr] gap-5 rounded-xl border p-4 text-inherit no-underline transition-[border-color,background-color] duration-200 max-sm:grid-cols-[1fr]"
    data-tag={tag}
    href={`/blog/${post.id}/`}
>
    <!-- Hidden below 600px: the thumbnail squeezes the title and description
    into a column too narrow to read. 599px rather than the site's usual 720px
    because this component already pivots at 600, and between 600 and 720 there
    is still room for the image. This hides the tag-tinted fallback plate too,
    which is correct -- it occupies the same slot. -->
    <div
        class="border-hairline size-20 overflow-hidden rounded-lg border max-sm:hidden sm:size-24"
    >
        {
            post.data.heroImage ? (
                <Image
                    src={post.data.heroImage}
                    width={192}
                    height={192}
                    alt=""
                    class="h-full w-full rounded-none object-cover opacity-85 grayscale-[0.35] transition-[filter,opacity] duration-500 group-hover:opacity-100 group-hover:grayscale-0"
                />
            ) : (
                <div class="fallback flex h-full w-full items-center justify-center font-mono text-2xl text-[var(--tag)]">
                    <span>{tag?.charAt(0).toUpperCase()}</span>
                </div>
            )
        }
    </div>

    <div class="min-w-0">
        <div
            class="text-subtle flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.03em]"
        >
            <FormattedDate date={post.data.pubDate} />
            {tag && <span aria-hidden="true">·</span>}
            {
                tag && (
                    <span class="inline-flex items-center gap-[0.4em] text-[var(--tag)] before:size-[0.45em] before:rounded-full before:bg-[var(--tag)] before:content-['']">
                        {tag}
                    </span>
                )
            }
        </div>
        <h3
            class="my-[0.4rem] text-xl leading-[1.25] group-hover:underline group-hover:decoration-[var(--tag)] group-hover:underline-offset-[3px]"
        >
            {post.data.title}
        </h3>
        <p
            class="text-subtle mt-0 mb-3 line-clamp-2 text-[0.9rem] leading-[1.5]"
        >
            {post.data.description}
        </p>
        <div
            class="text-subtle flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.03em]"
        >
            {minutes} min read
        </div>
    </div>
</a>

<style>
    /* These two stay as CSS. Both are per-tag `color-mix()` tints reading the
       declarative `--tag` from global.css, and as arbitrary-value utilities
       they would be a single unreadable token each. */
    .card:hover {
        border-color: color-mix(in oklab, var(--tag) 45%, var(--hairline));
    }

    /* A tint rather than a saturated fill: a saturated plate needs white text,
       which fails against the light pastels the dark theme uses. */
    .fallback {
        background: linear-gradient(
            135deg,
            color-mix(in oklab, var(--tag) 26%, var(--canvas-deep)),
            color-mix(in oklab, var(--tag) 8%, var(--canvas-deep))
        );
    }
</style>

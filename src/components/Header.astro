---
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="border-hairline bg-canvas border-b max-md:sticky max-md:top-0 max-md:z-20"
>
    <nav
        class="mx-auto flex w-[var(--measure-wide)] max-w-[calc(100%-2em)] items-center justify-between gap-4 px-[1em] max-md:max-w-full max-md:flex-wrap max-md:gap-0 max-md:px-[0.5em] max-md:py-[0.25em]"
    >
        <a
            class="text-prose-strong hover:text-ember py-[1.15em] font-mono text-[0.8125rem] font-semibold tracking-[0.02em] whitespace-nowrap no-underline max-md:hidden"
            href="/">jm</a
        >
        <div class="flex gap-0.5 max-md:gap-0">
            <HeaderLink href="/">home</HeaderLink>
            <HeaderLink href="/blog">blog</HeaderLink>
            <HeaderLink href="/now">now</HeaderLink>
            <HeaderLink href="/uses">uses</HeaderLink>
            <HeaderLink href="/cv">cv</HeaderLink>
        </div>
        <div class="flex items-center gap-3 max-md:ml-auto max-md:gap-1">
            <SocialLinks class="max-md:hidden" />
            <ThemeToggle />
        </div>
    </nav>
</header>

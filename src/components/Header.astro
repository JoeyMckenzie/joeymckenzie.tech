---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
    <nav>
        <a class="brand" href="/">{SITE_TITLE}</a>
        <div class="internal-links">
            <HeaderLink href="/">home</HeaderLink>
            <HeaderLink href="/blog">blog</HeaderLink>
            <HeaderLink href="/now">now</HeaderLink>
            <HeaderLink href="/uses">uses</HeaderLink>
            <HeaderLink href="/cv">cv</HeaderLink>
        </div>
        <div class="trailing">
            <SocialLinks />
            <ThemeToggle />
        </div>
    </nav>
</header>

<style>
    header {
        border-bottom: 1px solid var(--hairline);
        background: var(--canvas);
    }

    nav {
        width: var(--measure-wide);
        max-width: calc(100% - 2em);
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0 1em;
    }

    .brand {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.02em;
        color: var(--prose-strong);
        text-decoration: none;
        padding: 1.15em 0;
        white-space: nowrap;
    }

    .brand:hover {
        color: var(--ember);
    }

    .internal-links {
        display: flex;
        gap: 0.125rem;
    }

    .trailing {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    @media (max-width: 720px) {
        header :global(.social-links) {
            display: none;
        }

        /* Floats over the page on small screens only; desktop stays in flow.
           The opaque --canvas background and the bottom hairline are already
           set above, so content scrolls under it cleanly. */
        header {
            position: sticky;
            top: 0;
            z-index: 20;
        }

        /* One row: tabs left, theme toggle right. The wordmark is dropped here
           -- the `home` tab already links to `/`, and the page title carries
           the identity on a screen this size. */
        .brand {
            display: none;
        }
        /* flex-wrap stays as a safety net: if a narrower screen than 320px
           turns up, the toggle drops to a second row instead of giving the
           whole page a horizontal scrollbar. */
        nav {
            flex-wrap: wrap;
            gap: 0;
            /* The desktop `calc(100% - 2em)` leaves only 272px of usable width
               at 320px, which is 18px short of the tabs plus the toggle. On
               mobile the nav's own padding is the gutter, so the outer margin
               is redundant. */
            max-width: 100%;
            padding: 0.25em 0.5em;
        }
        .internal-links {
            gap: 0;
        }
        .trailing {
            gap: 0.25rem;
            margin-left: auto;
        }
    }
</style>
